{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feedback",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "routes": [
    {
      "pattern": "feedback.shauryaswebsites.com",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "FEEDBACK_STORE",
        "class_name": "FeedbackStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "FeedbackStore"
      ]
    }
  ],
  "services": [
    {
      "binding": "AUTH_SERVICE",
      "service": "user-management"
    }
  ]
}
